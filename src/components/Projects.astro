---
import type { PortfolioData } from '../data/portfolio';

interface Props {
  data: PortfolioData['featuredProjects'];
  labels: PortfolioData['labels'];
}

const { data, labels } = Astro.props;
---

<section id='projects'>
  <h2>{labels.projects}</h2>
  <div class='items'>
    {
      data.map((project) => (
        <div class='project-card'>
          <h3>{project.title}</h3>
          <p class='meta'>{project.subtitle}</p>
          <ul class='project-links-list'>
            {project.links.map((link) => (
              <li class='link-item'>
                <a
                  href={link.url}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='main-link'
                >
                  ↗ {link.label}
                </a>
                {link.credentials && (
                  <div class='cred-grid'>
                    {link.credentials.map((cred) => (
                      <div class='cred-row'>
                        <span class='cred-role'>{cred.role}</span>
                        <span class='cred-user'>{cred.user}</span>
                        <span class='cred-pass'>{cred.pass}</span>
                      </div>
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ul>
          <div class='content'>
            <ul class='bullet-list'>
              {project.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <p class='tech'>
              <strong>{labels.tech}:</strong> {project.technologies.join(', ')}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .project-card {
  }
  .project-links-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .link-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .main-link {
    color: var(--foreground);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .main-link:hover {
    color: var(--primary);
  }
  .cred-grid {
    display: grid;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-family: monospace;
    background-color: var(--muted);
    padding: 0.75rem;
    border-radius: 4px;
    border: 1px solid var(--border);
    margin-top: 0.25rem;
  }
  .cred-row {
    display: grid;
    grid-template-columns: 75px 1fr auto;
    gap: 0.5rem;
    align-items: center;
  }
  .cred-role {
    color: var(--primary);
    font-weight: bold;
  }
  .cred-user {
    color: var(--foreground);
  }
  .cred-pass {
    color: var(--muted-foreground);
  }
  @media (max-width: 500px) {
    .cred-row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
      margin-bottom: 0.5rem;
    }
    .cred-row:last-child {
      margin-bottom: 0;
    }
  }
</style>

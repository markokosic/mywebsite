---
import type { PortfolioData } from '../data/portfolio';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Contact from './Contact.astro';
import Skills from './Skills.astro';
import Experience from './Experience.astro';
import Projects from './Projects.astro';
import Education from './Education.astro';
import Principles from './Principles.astro';
import BeyondCode from './BeyondCode.astro';
import Footer from './Footer.astro';

interface Props {
  data: PortfolioData;
}

const { data } = Astro.props;
---

<Header contact={data.contact} labels={data.labels} />
<div class="portfolio-container">
  <Hero data={data.hero} />
  <Skills data={data.skills} labels={data.labels} />
  <Experience data={data.experience} labels={data.labels} />
  <Projects data={data.featuredProjects} labels={data.labels} />
  <Principles data={data.principles} title={data.labels.principles} />
  <BeyondCode data={data.beyondCode} title={data.labels.beyondCode} />
  <Education data={data.education} labels={data.labels} />
  <Contact data={data.contact} labels={data.labels} />
  <Footer data={data.contact} labels={data.labels} />
</div>

<style>
  .portfolio-container {
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }
</style>

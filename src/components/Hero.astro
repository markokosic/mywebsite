---
import type { PortfolioData } from '../data/portfolio';

interface Props {
  data: PortfolioData['hero'];
}

const { data } = Astro.props;
---

<section id="hero">
  <h2>{data.greeting}</h2>
  <h3>{data.headline}</h3>
  <div class="content">
    {data.about.map(paragraph => <p>{paragraph}</p>)}
  </div>
</section>


---
import type { PortfolioData } from '../data/portfolio';

interface Props {
  data: PortfolioData['hero'];
}

const { data } = Astro.props;
---

<section id='hero'>
  <p class='meta' style='margin-bottom: 0.5rem;'>{data.location}</p>
  <h1>{data.greeting}</h1>
  <h3>{data.headline}</h3>
  <div class='content'>
    {data.about.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>

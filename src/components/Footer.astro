---
import type { PortfolioData } from '../data/portfolio';

interface Props {
  data: PortfolioData['contact'];
  labels: PortfolioData['labels'];
}

const { data, labels } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  <div class='footer-content'>
    <div class='footer-section'>
      <p>&copy; {year} Marko Kosić</p>
      <div class='footer-links'>
        <a href={data.github.url} target='_blank' rel='noopener noreferrer'
          >{labels.github}</a
        >
        <span>|</span>
        <a href={data.linkedin.url} target='_blank' rel='noopener noreferrer'
          >{labels.linkedin}</a
        >
      </div>
    </div>

    <div class='footer-section legal'>
      <p>
        {labels.impressumText}<a
          href={`mailto:${data.email}`}
          class='copy-email-btn'
          data-email={data.email}
          data-copied={labels.copied}>{data.email}</a
        >
      </p>
      <p>{labels.privacyText}</p>
    </div>
  </div>
</footer>

<style>
  footer {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--muted-foreground);
    line-height: 1.5;
  }
  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .footer-section p {
    margin: 0 0 0.25rem 0;
  }
  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .footer-links a {
    color: var(--foreground);
    text-decoration: none;
  }
  .footer-links a:hover {
    text-decoration: underline;
  }
  .legal p {
    margin: 0 0 0.5rem 0;
  }
  .legal a {
    color: var(--foreground);
    text-decoration: none;
  }
  .legal a:hover {
    text-decoration: underline;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.copy-email-btn');
    buttons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const email = btn.getAttribute('data-email');
        const copiedText = btn.getAttribute('data-copied');
        const originalText = btn.innerHTML;

        if (email) {
          navigator.clipboard.writeText(email).then(() => {
            btn.innerHTML = copiedText || 'Copied!';
            setTimeout(() => {
              btn.innerHTML = originalText;
            }, 700);
          });
        }
      });
    });
  });
</script>

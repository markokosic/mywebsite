---
import { getLangFromUrl } from '../i18n/utils';
import '@fontsource/roboto-mono/400.css';
import '@fontsource/roboto-mono/400-italic.css';
import '@fontsource/roboto-mono/700.css';
import '@fontsource/roboto-mono/700-italic.css';
import '../styles/global.css';

const lang = getLangFromUrl(Astro.url);
const canonicalURL = new URL(Astro.url.pathname, 'https://www.kosic.dev');
const title = 'Marko Kosić - Software Engineer';
const description = 'Software Engineer focused on Fullstack Development (Java, Spring Boot, React, TypeScript).';
---

<html lang={lang}>
  <head>
    <meta charset='utf-8' />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name='viewport' content='width=device-width' />
    <title>{title}</title>

    <link rel="canonical" href={canonicalURL} />
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      <!-- <LanguagePicker /> -->
    </footer>
  </body>
</html>

    <meta charset='utf-8' />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name='viewport' content='width=device-width' />
    <title>Marko Kosić</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      <!-- <LanguagePicker /> -->
    </footer>
  </body>
</html>
